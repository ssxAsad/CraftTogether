{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.crafttogether.app",
  "productName": "CraftTogether",
  "compression": "normal",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "dist-electron",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/pidusage/**/*"
  ],
  "win": {
    "icon": "public/craftora.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh",
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "portable": {
    "splashImage": "build/splash.bmp",
    "artifactName": "${productName}-Portable-${version}.${ext}"
  },
  "mac": {
    "icon": "public/craftora.png",
    "category": "public.app-category.utilities",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "${productName}-macOS-${arch}-${version}.${ext}",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "title": "CraftTogether ${version}",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  }
}
