{
  "$schema": "./node_modules/app-builder-lib/scheme.json",
  "appId": "com.craftora.app",
  "productName": "Craftora",
  "compression": "normal",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist",
    "dist-electron",
    "package.json"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/pidusage/**/*"
  ],
  "win": {
    "icon": "public/craftora.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "include": "build/installer.nsh",
    "artifactName": "${productName} Setup ${version}.${ext}"
  },
  "portable": {
    "splashImage": "build/splash.bmp",
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
